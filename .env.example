# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Optional: extra CORS origins (comma-separated) beyond FRONTEND_URL
# CORS_ORIGINS=
# Optional: protects POST /api/admin/delete-grant and /api/admin/backfill-pushes.
# If unset, those admin endpoints refuse to run.
# ADMIN_SECRET=

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Create at https://github.com/settings/apps/new
# Set webhook URL to: https://YOUR-SERVER-URL/api/webhook/github
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_BOT_USERNAME=bankr-vesting[bot]
GITHUB_APP_SLUG=bankr-vesting

# ─── Oracle (hot wallet that calls GitEscrow.release on-chain) ────────────────
ORACLE_PRIVATE_KEY=0x...
# ORACLE_ADDRESS is read ONLY by the contract deploy scripts
# (contracts/deploy/*) — the server derives the address from the key.
ORACLE_ADDRESS=0x...

# ─── Base RPC ─────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# BASESCAN_API_KEY is used by Hardhat (contract verification) only.
BASESCAN_API_KEY=your_basescan_api_key
# GITHUB_API_BASE_URL — TEST ONLY: overrides the GitHub API base URL in
# E2E harnesses (fixture API). NEVER set in production.
# GITHUB_API_BASE_URL=

# ─── Smart contract ───────────────────────────────────────────────────────────
GIT_ESCROW_ADDRESS=0x...
# FeeStreamEscrow (launcher fee-lock grants, contracts/FeeStreamEscrow.sol) — Base
FEE_STREAM_ESCROW_ADDRESS=
GIT_ESCROW_ROBINHOOD_ADDRESS=0x706038b47ba6d0CC69479bB286d064137B50f6Ae
DEFAULT_VESTING_CHAIN=base

# ─── ShipRewards (optional — Ship spec §8B dual reward) ──────────────────────
# Address of the deployed ShipRewards pool contract. Leave unset to disable
# per-merge rewards entirely (the oracle safely no-ops).
# GIT_ESCROW_SEPOLIA_ADDRESS=
# SHIP_REWARDS_ADDRESS=
# SHIP_REWARDS_ROBINHOOD_ADDRESS=
# Flat reward paid per COUNTED merged PR, in the reward token's smallest
# unit (wei). Unset or 0 disables rewards.
# SHIP_REWARD_PER_MERGE=
# Reviewer swarm (src/lib/swarmReview.ts): independent PASS reviews
# required for a push to count on grants with swarmReviewRequired=true.
# SWARM_REVIEW_QUORUM=2
# Per-reviewer reward paid (from the same ShipRewards pool) to each PASS
# reviewer in a counted push's quorum, in wei. Unset -> 10% of
# SHIP_REWARD_PER_MERGE (placeholder; the reviewer share is an open
# schedule decision).
# SHIP_REVIEWER_REWARD_PER_MERGE=
# Platform reward treasury wallet — the 25% fee recipient on Proof of
# Dev platform SDK launches (75% goes to Gregory's wallet; split applies
# to the creator fee slice only — see src/lib/launchFeeConfig.ts).
# Must be a claim-capable wallet, NOT the ShipRewards contract.
# TODO: no dedicated wallet designated yet — leave unset until one is;
# platform launch-template building fails closed while this is empty.
# PLATFORM_REWARD_TREASURY_WALLET=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Public URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_random_32_char_string

# ─── GitLawb (optional) ───────────────────────────────────────────────────────
# GITLAWB_NODE_URL=https://node.gitlawb.com
# GITLAWB_WEBHOOK_SECRET=your_webhook_hmac_secret

# ─── Production (Railway) example ─────────────────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://vest.yourdomain.com
# SERVER_URL=https://api.yourdomain.com
# REDIS_URL=${{Redis.REDIS_URL}}  (Railway Redis plugin)
