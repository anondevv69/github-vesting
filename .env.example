# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Create at https://github.com/settings/apps/new
# Set webhook URL to: https://YOUR-SERVER-URL/api/webhook/github
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_BOT_USERNAME=bankr-vesting[bot]

# ─── Oracle (hot wallet that calls GitEscrow.release on-chain) ────────────────
ORACLE_PRIVATE_KEY=0x...
ORACLE_ADDRESS=0x...

# ─── Base RPC ─────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=your_basescan_api_key

# ─── Smart contract ───────────────────────────────────────────────────────────
GIT_ESCROW_ADDRESS=0x...

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Public URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_random_32_char_string

# ─── GitLawb (optional) ───────────────────────────────────────────────────────
# GITLAWB_NODE_URL=https://node.gitlawb.com
# GITLAWB_WEBHOOK_SECRET=your_webhook_hmac_secret

# ─── Production (Railway) example ─────────────────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://vest.yourdomain.com
# SERVER_URL=https://api.yourdomain.com
# REDIS_URL=${{Redis.REDIS_URL}}  (Railway Redis plugin)
