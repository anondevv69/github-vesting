{
  "name": "github-vesting",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub-activity-gated token vesting bot + escrow oracle for Bankr tokens",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"console.log('skip tsc — production uses tsx src/index.ts')\"",
    "start": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "compile:contracts": "hardhat compile",
    "deploy:base": "hardhat run contracts/deploy/deployGitEscrow.ts --network base",
    "deploy:base-sepolia": "hardhat run contracts/deploy/deployGitEscrow.ts --network baseSepolia",
    "deploy:mock-token": "hardhat run contracts/deploy/deployMockERC20.ts --network baseSepolia",
    "oracle:recover": "tsx scripts/recover-stuck-tokens.ts",
    "register:from-lock": "tsx scripts/register-from-lock.ts"
  },
  "dependencies": {
    "@octokit/app": "^13.1.8",
    "@octokit/rest": "^20.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "tsx": "^4.15.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "hardhat": "^2.22.0",
    "typescript": "^5.5.0"
  }
}
